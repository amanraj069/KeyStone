{
  "name": "@keystone/api",
  "version": "0.1.0",
  "private": true,
  "description": "Keystone API (NestJS). Talks to FalkorDB and Redis.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "test": "jest",
    "test:int": "jest --config jest.int.config.js --runInBand",
    "lint": "eslint src test scripts",
    "capability-check": "tsx scripts/capability-check.ts",
    "worker": "node dist/worker.js",
    "seed": "node dist/seed.js",
    "llm-check": "tsx scripts/llm-check.ts",
    "extract-sample": "tsx scripts/extract-sample.ts",
    "extract": "tsx scripts/extract.ts",
    "embed": "tsx scripts/embed.ts",
    "expertise": "tsx scripts/expertise.ts",
    "systems": "tsx scripts/systems.ts",
    "reingest-roles": "tsx scripts/reingest-roles.ts",
    "mcp:stdio": "tsc -p tsconfig.build.json 1>&2 && node dist/mcp/stdio.js",
    "mcp:check": "tsx scripts/mcp-check.ts",
    "ask": "tsx scripts/ask.ts",
    "bench": "tsx scripts/bench.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@google/genai": "2.25.0",
    "@keystone/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "bullmq": "^5.81.5",
    "falkordb": "6.8.0",
    "ioredis": "^5.11.1",
    "openai": "7.25.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
