# Settings for the Keystone web app (apps/web). Copy to apps/web/.env.local and fill in:
#   cp apps/web/.env.example apps/web/.env.local
# On Vercel, set the same variables under Project Settings -> Environment Variables.
#
# Where values come from, first match wins:
#   1. the real environment (Vercel, or your shell)
#   2. apps/web/.env.local (never committed)
#   3. API_BASE_URL in the repo-root .env (shared with the API, handy for local dev)
#   4. http://localhost:4000, only outside production builds (`pnpm dev`)
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time: after changing
# one, restart `pnpm dev` or redeploy on Vercel. A production build fails if none is set.

# The Keystone API the browser calls, with https:// and no trailing slash.
# Local: http://localhost:4000. Production: https://<API_DOMAIN> (docs/deploy.md, step 8).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
