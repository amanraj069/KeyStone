{
  "name": "keystone",
  "private": true,
  "description": "Keystone: a Company Brain agent built on FalkorDB (Graph Hacks 2026).",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @keystone/shared build && pnpm --parallel --filter @keystone/shared --filter @keystone/api --filter @keystone/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "capability-check": "pnpm --filter @keystone/api capability-check",
    "llm-check": "pnpm --filter @keystone/api llm-check",
    "extract": "pnpm --filter @keystone/api extract",
    "embed": "pnpm --filter @keystone/api embed",
    "expertise": "pnpm --filter @keystone/api expertise",
    "systems": "pnpm --filter @keystone/api systems",
    "reingest-roles": "pnpm --filter @keystone/api reingest-roles"
  }
}
