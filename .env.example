# Copy to .env and fill in. Never commit .env.
# docker compose reads this file too (FALKOR_PASSWORD).

# --- FalkorDB (local Docker container, see docker-compose.yml) ---
FALKOR_HOST=localhost
FALKOR_PORT=6379
# Required. No spaces: the image passes it to redis-server via REDIS_ARGS.
FALKOR_PASSWORD=change-me-to-a-long-random-string
# Host port for the FalkorDB Browser UI (docker compose only; local dev).
# Not 3000: that is the Keystone web app.
FALKOR_BROWSER_PORT=3100

# --- Redis for BullMQ (separate container; never FalkorDB) ---
REDIS_URL=redis://localhost:6380

# --- LLM provider ---
# yes: use OpenAI (needs OPENAI_API_KEY). no (default): use Gemini (needs GEMINI_API_KEYS).
USE_OPENAI=no

# --- OpenAI (used when USE_OPENAI=yes) ---
OPENAI_API_KEY=
# gpt-5-nano: measured on a 200-artifact sample, good enough for extraction and ~5x cheaper than gpt-5-mini.
OPENAI_MODEL=gpt-5-nano
# Embeddings are shortened to EMBED_DIM via the API's `dimensions` option.
OPENAI_EMBED_MODEL=text-embedding-3-small
# GPT-5 models: minimal | low | medium | high. Reasoning is billed as output tokens; minimal is cheapest.
OPENAI_REASONING_EFFORT=minimal
# Reasoning effort for the question-answering agent (POST /agent/ask), OpenAI only.
AGENT_REASONING_EFFORT=low

# --- Gemini (used when USE_OPENAI=no) ---
# Comma separated; requests rotate across keys.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- LLM cache (DATA_DIR/llm-cache) ---
# yes: never call the LLM; a cache miss is an error (proves a rerun costs zero LLM calls).
LLM_CACHE_ONLY=no
# At most this many LLM requests at once (lower it if you hit rate limits).
LLM_CONCURRENCY=4
# Embedding vector size stored on Chunk.embedding (integer; used in the vector index).
EMBED_DIM=768

# --- Extraction (POST /extract/run) ---
# Refuse to start if more LLM calls than this are planned (pass force to override).
EXTRACT_MAX_CALLS=4000
# Optional, comma separated: only artifacts authored by these departments.
EXTRACT_DEPTS=

# --- System catalog ---
# A System is "core" (bus factor, departure impact, apex_proj) when at least this many
# artifacts mention it, written by at least 2 different people.
CORE_MIN_MENTIONS=5

# --- What-if simulations ---
# At most this many departure simulations (each a GRAPH.COPY of apex_proj) at once.
WHATIF_MAX_CONCURRENT=2

# --- Memory guard (GraphService.assertMemoryBudget), below the 4 GB container limit ---
MEMORY_WARN_MB=3000
MEMORY_MAX_MB=3600

# --- TextStore (artifact bodies and chunk text live here, not in the graph) ---
# local | s3. Only local works today: the S3 TextStore and extraction cache are not built yet,
# so TEXT_STORE=s3 (or any S3_BUCKET) stops the API and worker at startup. Keep it local.
TEXT_STORE=local
# For TEXT_STORE=s3 once it exists. The actions export already supports it: it would write to
# s3://S3_BUCKET/exports/ with the AWS SDK's credentials (EC2 instance role, or AWS_REGION /
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY).
S3_BUCKET=
# Root folder for OrgForge files, TextStore and LLM caches.
DATA_DIR=./data

# --- Ingestion ---
# true: the API process also runs the BullMQ ingest worker (dev). false: run dist/worker.js separately (prod).
INGEST_WORKER_INLINE=true
# Optional in dev. When set, POST /ingest/* and approving/rejecting actions need the header
# "x-admin-token: <value>". POST /admin/* (backup, restore, export-actions) is disabled until it is set.
ADMIN_TOKEN=

# --- HTTP ---
# The only origin allowed by CORS on the API.
WEB_ORIGIN=http://localhost:3000
# Where the web app reaches the API.
API_BASE_URL=http://localhost:4000
# Optional: overrides API_BASE_URL for the web app's browser bundle (set on Vercel to
# https://API_DOMAIN). Read at build time by apps/web/next.config.ts.
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# --- Production compose (docker-compose.prod.yml; values live in .env.prod) ---
# Optional: the env file api and worker load (default .env.prod).
# KEYSTONE_ENV_FILE=.env.prod
# Optional: the host folder mounted as /repo/data in api and worker (default ./data).
# KEYSTONE_DATA_DIR=./data

# --- Benchmark (pnpm bench; reads data/answer_key/, writes data/bench/) ---
# Questions sampled per question type for Part B2.
BENCH_PER_TYPE=15
# Sampling seed: the same seed picks the same questions on every run.
BENCH_SEED=13
# Optional: the model that judges answers and checks B1 names (same provider). Empty: the same
# model as the systems under test (OPENAI_MODEL / GEMINI_MODEL).
BENCH_JUDGE_MODEL=
