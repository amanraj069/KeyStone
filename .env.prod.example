# Production settings for docker-compose.prod.yml (docs/deploy.md). On the server:
#   cp .env.prod.example .env.prod && chmod 600 .env.prod   (then fill it in)
#   ln -s .env.prod .env      # docker compose reads FALKOR_PASSWORD / API_DOMAIN from .env
# Never commit .env.prod. Values with a $ in them (the bcrypt hash) must be in 'single quotes'.
# FALKOR_HOST, FALKOR_PORT, REDIS_URL, DATA_DIR, INGEST_WORKER_INLINE and API_BASE_URL are
# set by docker-compose.prod.yml itself and need not be here.

# --- Public address -------------------------------------------------------------
# The API's hostname, without https://. Caddy gets its certificate for this name.
# No domain? Use the Elastic IP with dashes + .sslip.io, e.g. 203-0-113-10.sslip.io
API_DOMAIN=
# The Vercel URL of the web app (the only origin CORS allows), no trailing slash. It must be a
# valid URL for the API to start: keep this placeholder until the web app is deployed.
WEB_ORIGIN=https://replace-me.vercel.app

# --- Secrets ----------------------------------------------------------------------
# Long random strings, no spaces: openssl rand -hex 32
FALKOR_PASSWORD=
# Required in production: protects POST /ingest/*, /actions/:id/approve|reject and /admin/*.
ADMIN_TOKEN=

# --- LLM provider (the agent answers questions live; the seed never calls it) ---------
# Must match what built the caches in data/: the provider and models are part of every cache key.
USE_OPENAI=yes
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_REASONING_EFFORT=minimal
AGENT_REASONING_EFFORT=low
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
LLM_CONCURRENCY=4
# no: the agent may call the LLM for new questions (answers are cached). yes: cache only.
LLM_CACHE_ONLY=no

# --- Graph rules (keep the values the graph was built with) ------------------------
CORE_MIN_MENTIONS=5
WHATIF_MAX_CONCURRENT=2
MEMORY_WARN_MB=3000
MEMORY_MAX_MB=3600

# --- Storage ------------------------------------------------------------------------
# local: TextStore, caches and exports in ./data on the instance's disk.
TEXT_STORE=local
S3_BUCKET=

# --- Optional: FalkorDB Browser behind basic auth (off by default) ------------------
# BROWSER_DOMAIN=browser-203-0-113-10.sslip.io
# BROWSER_USER=admin
# Hash from: docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# BROWSER_PASSWORD_HASH='$2a$14$...'
